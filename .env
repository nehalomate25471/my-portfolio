# =========================================================
# CareerForge AI — environment variables
# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it is already in .gitignore.
# =========================================================

# --- Database (PostgreSQL via Prisma) ---
# Any Postgres host works: Neon, Supabase, Railway, RDS, local Docker, etc.
DATABASE_URL="postgresql://user:password@localhost:5432/careerforge?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate with: npx auth secret
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- GitHub OAuth (login + repository import) ---
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- OpenAI (AI resume/portfolio assistant, resume parsing) ---
# Server-side only — never exposed to the client.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- File storage (resumes, profile images, project images) ---
# Vercel Blob is the default target for this scaffold.
# Swap for S3/R2/Supabase Storage by replacing src/lib/storage.ts.
BLOB_READ_WRITE_TOKEN=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
